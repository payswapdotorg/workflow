generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Chat {
  id             String    @id @default(cuid())
  title          String
  createdAt      DateTime  @default(now())
  buildPhase     String?
  buildDetail    String?
  buildProgress  Int?
  buildSlug      String?
  buildUpdatedAt DateTime?
  messages       Message[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  text      String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}
