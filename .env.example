# TeachCast environment — copy to .env and adjust.
#   cp .env.example .env

# SQLite database (the only required variable).
# Prisma resolves "file:" paths relative to prisma/schema.prisma, so this
# lands in the gitignored db/ directory at the project root.
DATABASE_URL="file:../db/custom.db"

# --------------------------------------------------------------------
# LLM provider — the self-hosting ladder (M8). All optional.
#
#   1. Settings UI (endpoint/key/model stored server-side in the DB)
#   2. The env vars below — the deployment channel. Point them at the
#      self-hosted GLM endpoint (see modal/README.md: `modal deploy
#      modal/glm_modal.py`) and TeachCast stops depending on the shared
#      Z.ai API entirely — no shared balance, no shared rate limit.
#   3. Built-in z-ai-web-dev-sdk fallback (local dev only).
#
# PROVIDER_ENDPOINT=https://<workspace>--glm.modal.run/v1
# PROVIDER_API_KEY=<the GLM_API_KEY you created with `modal secret create`>
# PROVIDER_MODEL=glm-4.7-flash

# --------------------------------------------------------------------
# Browser backend (M8). Optional — default is LOCAL (agent-browser CLI on
# this host; zero change for existing deployments).
#
# Setting E2B_API_KEY switches browser_control and the managed console to
# an E2B sandbox: the same agent-browser CLI contract executes INSIDE the
# sandbox, which is what makes the browser capability work on serverless
# hosts (Vercel). Build the custom template once for ~instant starts:
#
#   cd e2b-template && npx @e2b/cli template create teachcast-browser \
#     -d Dockerfile --cpu-count 2 --memory-mb 4096
#
# E2B_API_KEY=e2b-...
# E2B_TEMPLATE=teachcast-browser    # default "base" (runtime bootstrap)
# E2B_SANDBOX_TIMEOUT_MS=900000     # 15 min, bumped on every action
# E2B_BOOTSTRAP_TIMEOUT_MS=300000   # one-shot install budget
# BROWSER_BACKEND=e2b               # force E2B even without a key (fails loud)
