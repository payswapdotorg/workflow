# TeachCast environment — copy to .env and adjust.
#   cp .env.example .env

# SQLite database (the only required variable).
# Prisma resolves "file:" paths relative to prisma/schema.prisma, so this
# lands in the gitignored db/ directory at the project root.
DATABASE_URL="file:../db/custom.db"

# No LLM keys are needed here: provider settings (endpoint / model / key) are
# configured in the app under Settings and stored server-side in the database.
# Without a configured provider TeachCast uses its built-in fallback LLM.
